# Mentora Backend Configuration

PROJECT_NAME="Mentora API"
API_V1_STR="/api/v1"

# Security / JWT
SECRET_KEY="mentora-development-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default local SQLite; replace with your Neon connection string anytime)
DATABASE_URL="sqlite:///./mentora.db"

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000"]
