# Mentora Backend Configuration

PROJECT_NAME="Mentora API"
API_V1_STR="/api/v1"

# Security / JWT
# Generate a secure secret in production, e.g.: openssl rand -hex 32
SECRET_KEY="mentora-development-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database:
# For Neon PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"
# For Local SQLite:
DATABASE_URL="sqlite:///./mentora.db"

# CORS Origins (JSON list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000"]
